BOT_TOKEN=put_your_bot_token_here
DATABASE_URL=sqlite:///hidl.db
APP_ENV=development
DEBUG_LOG=0
# Optional: one-time bootstrap for empty volume (public URL to hidl.db)
# BOOTSTRAP_DB_URL=

# --- LLM (OpenAI / OpenAI-compatible / DeepSeek / Qwen) ---
# Leave LLM_ENABLED empty to auto-enable when provider, base URL, key and model are set.
# Set LLM_ENABLED=0 to force offline deterministic mode.
# LLM_ENABLED=
LLM_PROVIDER=openai
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=
# LLM_PROXY_URL=
LLM_REASONING_EFFORT=none
LLM_TIMEOUT_SEC=15
LLM_MAX_TOKENS=1200

# Provider-specific vars (also used as defaults when LLM_PROVIDER matches)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=
# OPENAI_PROXY_URL=

# Optional failover LLM route
# LLM_FAILOVER_PROVIDER=deepseek
# LLM_FAILOVER_API_KEY=
# LLM_FAILOVER_BASE_URL=
# LLM_FAILOVER_MODEL=
# LLM_FAILOVER_PROXY_URL=
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=
# QWEN_API_KEY=
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=

# --- Speech-to-Text (Voice messages) ---
# STT_PROVIDER=auto  (auto | custom | groq | openai | qwen | off)
STT_PROVIDER=auto
# GROQ_API_KEY=
# STT_GROQ_MODEL=whisper-large-v3-turbo
# STT_OPENAI_MODEL=whisper-1
# STT_QWEN_MODEL=qwen3-asr-flash
# STT_API_KEY=
# STT_BASE_URL=
# STT_MODEL=
# STT_PROXY_URL=
STT_LANGUAGE=ru
STT_TIMEOUT_SEC=30
STT_MAX_DURATION_SEC=180
