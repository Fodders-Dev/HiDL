# Production environment template for HiDL systemd service (/etc/hidl/hidl.env)
# Permissions recommended: root:hidl 0640. Never commit real keys or tokens.

BOT_TOKEN=
DATABASE_URL=/var/lib/hidl/hidl.db
APP_ENV=production
DEBUG_LOG=0

# --- Primary LLM (GameBot-compatible OpenAI route) ---
LLM_ENABLED=1
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-6-luna
# OPENAI_PROXY_URL=
LLM_REASONING_EFFORT=none
LLM_TIMEOUT_SEC=15
LLM_MAX_TOKENS=1200

# --- Reserve LLM (DeepSeek failover when key is present) ---
LLM_FAILOVER_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# --- Voice STT (can be tested separately; set STT_PROVIDER=off to disable) ---
STT_PROVIDER=auto
# GROQ_API_KEY=
# STT_GROQ_MODEL=whisper-large-v3-turbo
# STT_OPENAI_MODEL=whisper-1
# QWEN_API_KEY=
# STT_QWEN_MODEL=qwen3-asr-flash
STT_LANGUAGE=ru
STT_TIMEOUT_SEC=30
STT_MAX_DURATION_SEC=180
